#include <windows.h>
#include "version.h"

101 ICON "icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MDZY_VERSION_NUM
PRODUCTVERSION MDZY_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "mdzy (MD easy) - Markdown and text viewer"
            VALUE "FileVersion", MDZY_VERSION
            VALUE "InternalName", "mdzy"
            VALUE "OriginalFilename", "mdzy.exe"
            VALUE "ProductName", "mdzy"
            VALUE "ProductVersion", MDZY_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
